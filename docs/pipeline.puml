@startuml
title Hum-to-MIDI Core Pipeline

start

:Hummed melody (WAV file);

partition "librosa" {
  :Load audio, resample to 16 kHz mono;
}

partition "torchcrepe" {
  :Detect pitch frame by frame
  (frequency + confidence + loudness);
}

partition "NumPy" {
  :Drop silent and low-confidence frames;
  :Smooth pitch curve, correct sharp/flat drift;
  :Split at gaps and loudness dips;
  :Group stable regions into notes
  (start, end, MIDI pitch);
}

partition "librosa" {
  :Estimate tempo from note starts;
}

partition "NumPy" {
  :Fine-tune tempo;
  :Snap note timings to beat grid;
  :Detect key;
  if (snap to key?) then (yes)
    :Move out-of-key notes into the key;
  endif
}

partition "pretty_midi" {
  :Build MIDI notes;
  :Write MIDI file;
}

:Clean MIDI file (ready for DAW);

stop
@enduml
